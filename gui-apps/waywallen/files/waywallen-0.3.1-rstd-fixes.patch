From: hypengw <hypengwip@gmail.com>
Date: Fri, 7 Aug 2026 11:25:14 +0000
Subject: [PATCH] fix clang argparse module crash

---
 src/argparse/src/arg.cppm | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/argparse/src/arg.cppm b/src/argparse/src/arg.cppm
index 0fb32e2..0ea07c6 100644
--- a/src/argparse/src/arg.cppm
+++ b/src/argparse/src/arg.cppm
@@ -382,6 +382,10 @@ public:
     }
 };
 
+// Clang 22 can crash under -Wuninitialized when consumers instantiate constrained members from the BMI.
+template class Arg<bool>;
+template class Arg<u8>;
+
 } // namespace rstd::argparse
 
 template<typename T>
